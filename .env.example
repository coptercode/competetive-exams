# Database – PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms_db?schema=public"
# Same as DATABASE_URL unless you're using a pooled connection (e.g. Supabase pgbouncer),
# in which case this should point at the direct (non-pooled) connection.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lms_db?schema=public"

# Backend configuration
PORT=3000
# Required. In production the server refuses to start without this set to a strong random value.
JWT_SECRET="your-jwt-secret-here"
# Set to "production" in production deployments — enables strict env validation,
# disables the embedded-postgres dev fallback and /api/dev/* debug routes.
NODE_ENV="development"
# Comma-separated list of allowed frontend origins for CORS, e.g. "https://app.example.com".
# Required in production — with NODE_ENV=production and this unset, all cross-origin requests are blocked.
ALLOWED_ORIGINS=""
# Set to "true" to allow the AI Tutor/Quiz generator to fall back to the public, unauthenticated
# pollinations.ai API when Gemini is unavailable. Off by default in production since student
# questions/attachments would be sent to a third party with no data-processing agreement.
ENABLE_PUBLIC_AI_FALLBACK="false"

# Frontend configuration
VITE_API_URL="http://localhost:3000/api"

# AI Tutor Integration
GEMINI_API_KEY="your-gemini-api-key-here"

# Gmail SMTP Configuration
SMTP_USER="dharaneshgopal@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Nexora Learning <dharaneshgopal@gmail.com>"

# MinIO Configuration (S3-compatible local object storage)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin123"
MINIO_BUCKET="lms-files"
MINIO_USE_SSL=false

# Only needed if using docker-compose.yml to run Postgres/MinIO locally
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="lms_db"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="change-me"

# LiveKit Cloud Configuration
LIVEKIT_URL="your-livekit-url-here"
LIVEKIT_API_KEY="your-livekit-api-key-here"
LIVEKIT_API_SECRET="your-livekit-api-secret-here"
VITE_LIVEKIT_URL="your-livekit-url-here"

