{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2020"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist-server",
    "resolveJsonModule": true
  },
  "include": ["server/**/*", "prisma/**/*"],
  "exclude": ["node_modules", "scripts/**/*", "**/*.test.ts"]
}
